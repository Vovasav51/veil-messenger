<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Veil" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand + surfaces -->
        <item name="colorPrimary">@color/veil_primary</item>
        <item name="colorOnPrimary">@color/veil_on_primary</item>
        <item name="colorPrimaryContainer">@color/veil_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/veil_on_primary_container</item>
        <item name="colorSecondary">@color/veil_accent</item>
        <item name="colorError">@color/veil_danger</item>
        <item name="android:colorBackground">@color/veil_bg</item>
        <item name="colorSurface">@color/veil_surface</item>
        <item name="colorSurfaceVariant">@color/veil_surface_alt</item>
        <item name="colorOnSurface">@color/veil_text</item>
        <item name="colorOnSurfaceVariant">@color/veil_text_muted</item>
        <item name="colorOutline">@color/veil_outline</item>
        <item name="colorOutlineVariant">@color/veil_outline</item>
        <item name="colorSurfaceContainerLowest">@color/veil_bg</item>
        <item name="colorSurfaceContainerLow">@color/veil_surface</item>
        <item name="colorSurfaceContainer">@color/veil_surface</item>
        <item name="colorSurfaceContainerHigh">@color/veil_surface</item>
        <item name="colorSurfaceContainerHighest">@color/veil_surface_alt</item>

        <!-- Semantic colours used by bubbles and verification status -->
        <item name="veilBubbleIn">@color/veil_bubble_in</item>
        <item name="veilBubbleOut">@color/veil_bubble_out</item>
        <item name="veilBubbleInText">@color/veil_bubble_in_text</item>
        <item name="veilBubbleOutText">@color/veil_bubble_out_text</item>
        <item name="veilStatusOk">@color/veil_ok</item>
        <item name="veilStatusPending">@color/veil_warn</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/veil_bg</item>
        <item name="android:statusBarColor">@color/veil_bg</item>
        <item name="android:navigationBarColor">@color/veil_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/veil_text</item>
        <item name="android:textColorSecondary">@color/veil_text_muted</item>

        <!-- Defaults for widgets that are not styled at the layout site -->
        <item name="materialButtonStyle">@style/Widget.Veil.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Veil.Card</item>
        <item name="toolbarStyle">@style/Widget.Veil.Toolbar</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Veil.AlertDialog</item>
    </style>

    <style name="ThemeOverlay.Veil.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/veil_surface</item>
        <item name="colorOnSurface">@color/veil_text</item>
        <item name="colorPrimary">@color/veil_primary</item>
    </style>

    <!-- App bar. Height is wrap_content + minHeight in the layouts so that the
         status-bar inset can grow it instead of clipping the title. -->
    <style name="Widget.Veil.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?android:colorBackground</item>
        <item name="android:elevation">0dp</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="subtitleTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="titleTextAppearance">@style/TextAppearance.Veil.ToolbarTitle</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.Veil.Caption</item>
        <item name="titleMarginStart">4dp</item>
    </style>

    <style name="TextAppearance.Veil.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.Veil.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textSize">42sp</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="TextAppearance.Veil.Headline" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Veil.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Veil.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="TextAppearance.Veil.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <style name="TextAppearance.Veil.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.Veil.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.Veil.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.Veil.Fingerprint" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:lineSpacingMultiplier">1.6</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Primary action: one filled button per screen. -->
    <style name="Widget.Veil.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.Veil.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="strokeColor">?attr/colorOutline</item>
    </style>

    <style name="Widget.Veil.Button.Outlined.Danger" parent="Widget.Veil.Button.Outlined">
        <item name="android:textColor">?attr/colorError</item>
        <item name="strokeColor">?attr/colorError</item>
        <item name="iconTint">?attr/colorError</item>
    </style>

    <!-- Secondary action: copy, add, verify. -->
    <style name="Widget.Veil.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="iconPadding">8dp</item>
        <item name="iconTint">?attr/colorPrimary</item>
    </style>

    <!-- Round send button in the chat composer (icon only, no text). -->
    <style name="Widget.Veil.SendButton" parent="Widget.Material3.Button">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">13dp</item>
        <item name="android:paddingRight">13dp</item>
        <item name="android:paddingTop">13dp</item>
        <item name="android:paddingBottom">13dp</item>
        <item name="cornerRadius">24dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Veil.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/corner_l</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
    </style>

    <!-- Tinted card used for notices and the limits block. -->
    <style name="Widget.Veil.Card.Muted" parent="Widget.Veil.Card">
        <item name="cardBackgroundColor">?attr/colorSurfaceVariant</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.Veil.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/corner_m</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_m</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_m</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_m</item>
        <item name="hintTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="boxBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
