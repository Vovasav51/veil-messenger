<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Veil" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/veil_primary</item>
        <item name="colorOnPrimary">@color/veil_on_primary</item>
        <item name="colorPrimaryContainer">@color/veil_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/veil_on_primary_container</item>
        <item name="colorSecondary">@color/veil_accent</item>
        <item name="colorError">@color/veil_danger</item>
        <item name="android:colorBackground">@color/veil_bg</item>
        <item name="colorSurface">@color/veil_surface</item>
        <item name="colorSurfaceVariant">@color/veil_surface_alt</item>
        <item name="colorOnSurface">@color/veil_text</item>
        <item name="colorOnSurfaceVariant">@color/veil_text_muted</item>
        <item name="colorOutline">@color/veil_outline</item>
        <item name="android:windowBackground">@color/veil_bg</item>
        <item name="android:statusBarColor">@color/veil_bg</item>
        <item name="android:navigationBarColor">@color/veil_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:textColorPrimary">@color/veil_text</item>
        <item name="android:textColorSecondary">@color/veil_text_muted</item>
        <item name="materialButtonStyle">@style/Widget.Veil.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Veil.Card</item>
        <item name="toolbarStyle">@style/Widget.Veil.Toolbar</item>
    </style>

    <style name="Widget.Veil.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/veil_bg</item>
        <item name="titleTextColor">@color/veil_text</item>
        <item name="subtitleTextColor">@color/veil_text_muted</item>
        <item name="titleTextAppearance">@style/TextAppearance.Veil.ToolbarTitle</item>
    </style>

    <style name="TextAppearance.Veil.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.Veil.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Veil.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Veil.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/veil_outline</item>
    </style>

    <style name="TextAppearance.Veil.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="TextAppearance.Veil.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="TextAppearance.Veil.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/veil_text_muted</item>
    </style>

    <style name="TextAppearance.Veil.Fingerprint" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
        <item name="android:textColor">@color/veil_text</item>
    </style>
</resources>
