    <!-- Onboarding -->
    <string name="onboarding_tagline">Приватний текстовий зв\'язок</string>
    <string name="onboarding_intro">Один пристрій на акаунт. Без номера телефону, без відновлення акаунта. Ключі створюються на цьому пристрої й ніколи його не залишають.</string>
    <string name="onboarding_server_label">Адреса релею</string>
    <string name="onboarding_server_hint">https://relay.example.org</string>
    <string name="onboarding_handle_label">Псевдонім</string>
    <string name="onboarding_handle_hint">наприклад, olena_k</string>
    <string name="onboarding_handle_helper">3–24 символи: a–z, 0–9 та «_». Символ @ на початку необов\'язковий.</string>
    <string name="onboarding_create">Створити акаунт</string>
    <string name="onboarding_retry">Продовжити реєстрацію</string>
    <string name="onboarding_pending_title">Реєстрація не завершена</string>
    <string name="onboarding_pending_body">UID цього пристрою вже збережено. Повторіть спробу з тим самим UID — новий акаунт не створюється.</string>
    <string name="onboarding_local_note">Дані зберігаються лише на цьому пристрої у зашифрованому сховищі. Резервних копій немає.</string>

