<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark variant of Theme.Veil. Kept identical to values/themes.xml except
         for the system-bar icon appearance, because a style resource found in a
         qualified folder replaces the default one entirely instead of being
         merged with it. -->
    <style name="Theme.Veil" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand + surfaces -->
        <item name="colorPrimary">@color/veil_primary</item>
        <item name="colorOnPrimary">@color/veil_on_primary</item>
        <item name="colorPrimaryContainer">@color/veil_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/veil_on_primary_container</item>
        <item name="colorSecondary">@color/veil_accent</item>
        <item name="colorError">@color/veil_danger</item>
        <item name="android:colorBackground">@color/veil_bg</item>
        <item name="colorSurface">@color/veil_surface</item>
        <item name="colorSurfaceVariant">@color/veil_surface_alt</item>
        <item name="colorOnSurface">@color/veil_text</item>
        <item name="colorOnSurfaceVariant">@color/veil_text_muted</item>
        <item name="colorOutline">@color/veil_outline</item>
        <item name="colorOutlineVariant">@color/veil_outline</item>
        <item name="colorSurfaceContainerLowest">@color/veil_bg</item>
        <item name="colorSurfaceContainerLow">@color/veil_surface</item>
        <item name="colorSurfaceContainer">@color/veil_surface</item>
        <item name="colorSurfaceContainerHigh">@color/veil_surface</item>
        <item name="colorSurfaceContainerHighest">@color/veil_surface_alt</item>

        <!-- Semantic colours used by bubbles and verification status -->
        <item name="veilBubbleIn">@color/veil_bubble_in</item>
        <item name="veilBubbleOut">@color/veil_bubble_out</item>
        <item name="veilBubbleInText">@color/veil_bubble_in_text</item>
        <item name="veilBubbleOutText">@color/veil_bubble_out_text</item>
        <item name="veilStatusOk">@color/veil_ok</item>
        <item name="veilStatusPending">@color/veil_warn</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/veil_bg</item>
        <item name="android:statusBarColor">@color/veil_bg</item>
        <item name="android:navigationBarColor">@color/veil_bg</item>
        <!-- Dark surfaces need light system-bar icons. -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/veil_text</item>
        <item name="android:textColorSecondary">@color/veil_text_muted</item>

        <!-- Defaults for widgets that are not styled at the layout site -->
        <item name="materialButtonStyle">@style/Widget.Veil.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Veil.Card</item>
        <item name="toolbarStyle">@style/Widget.Veil.Toolbar</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Veil.AlertDialog</item>
    </style>
</resources>
