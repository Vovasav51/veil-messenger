[Unit]
Description=Veil development ciphertext relay (loopback only)
Documentation=file:/opt/veil-relay/README.md
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
DynamicUser=yes
StateDirectory=veil-relay
StateDirectoryMode=0700
WorkingDirectory=/var/lib/veil-relay
ExecStart=/usr/bin/python3 /opt/veil-relay/veil-relay.pyz --host 127.0.0.1 --port 8787 --db /var/lib/veil-relay/relay.sqlite3
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
Environment=PYTHONUNBUFFERED=1
Environment=VEIL_DEBUG=0

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
SystemCallArchitectures=native
TasksMax=96
MemoryMax=256M
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
