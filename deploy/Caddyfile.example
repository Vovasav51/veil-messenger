# Example only. Replace domain; relay must stay on loopback.
# No access log directive: do not log identities, Authorization or request bodies.
veil.example.com {
    request_body {
        max_size 512KB
    }
    reverse_proxy 127.0.0.1:8787 {
        transport http {
            dial_timeout 5s
            response_header_timeout 20s
            read_timeout 30s
            write_timeout 30s
        }
    }
}
